# ─────────────────────────────────────────────────────────────
# Kosh MFS — frontend environment
# Copy to .env.local and adjust. NEXT_PUBLIC_* values are inlined
# into the browser bundle at build time — never put secrets in them.
# ─────────────────────────────────────────────────────────────

# Which API implementation the UI talks to:
#   supabase — API runs on this Next.js server; data lives in your Supabase
#              PostgreSQL database (run supabase/schema.sql then seed.sql first)
#   http     — separate REST backend at NEXT_PUBLIC_API_BASE_URL
NEXT_PUBLIC_API_MODE=supabase

# Server-only. Required when NEXT_PUBLIC_API_MODE=supabase.
# Supabase → Project Settings → Database → Connection string → "Transaction pooler"
# (port 6543). Replace [YOUR-PASSWORD] with your database password.
# Use the pooler, not the "Direct connection" (that one is IPv6-only).
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Base URL of the REST backend (only used when NEXT_PUBLIC_API_MODE=http).
# Prefer a same-site origin (e.g. https://api.example.com behind the same
# parent domain, or a /api rewrite) so the session cookie stays SameSite=Lax.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# Server-only. Secret used to sign the session JWT (HS256), at least 32 chars.
# The route guard (src/proxy.ts) verifies the cookie with it before trusting
# the role claim. Required.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_JWT_SECRET=change-me-to-a-long-random-string

# ─────────────────────────────────────────────────────────────
# AI insights (merchant & agent intelligence). Server-only — never prefix
# these with NEXT_PUBLIC_. All are optional: without keys every insight
# still works, with template wording instead of AI wording.
# Order tried: GEMINI_MODEL → GEMINI_FALLBACK_MODEL (both with GEMINI_API_KEY)
# → GROQ_MODEL (with GROQ_API_KEY) → template.
# Model IDs must match each API's model list (Google AI Studio / Groq console).
# ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemma-4-31b-it
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ─────────────────────────────────────────────────────────────
# Email (server-only). OTP codes are emailed to accounts that have an email
# address, along with account, security and transaction emails. Leave the
# password empty to disable email; codes are then shown on screen (dev SMS).
# Brevo → SMTP & API → SMTP. EMAIL_FROM must be a verified sender in Brevo.
# ─────────────────────────────────────────────────────────────
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
EMAIL_FROM="Kosh <no-reply@your-domain.com>"
# SMS (server-only): OTP codes by text message through sms.net.bd (Alpha SMS).
# Without a key, codes go to the development SMS provider (server log + on screen).
SMS_NET_BD_API_KEY=
# Optional approved sender ID
SMS_SENDER_ID=
# Public URL used for links in emails (defaults to the request's origin).
APP_URL=
# Show OTP codes on screen (development SMS provider). Set to false in production.
OTP_SHOW_CODES=true
